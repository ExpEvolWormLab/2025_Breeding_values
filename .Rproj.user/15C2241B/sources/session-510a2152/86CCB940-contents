### Univariate
#### GBLUP ####
# Model as: y = Xb + Wr + u + e 
# X: fixed effects
# W: random effects
# u: follows normal distribution with variance of A*Var(u)

# Define prior model for GBLUP
# Convert Ginv to sparse matrix format
G_subset <- G[colnames(G)%in%unique(phen_with_iso$pop_label),colnames(G)%in%unique(phen_with_iso$pop_label)]
Ginv <- G.inverse(G = G_subset)$Ginv
Ginv.mat <- as(Ginv, "dgCMatrix")
nb_trait = 1

phen.var = diag(nb_trait) * diag(var(subset(d, select = ii)))
prior_mod <- list(G = list(G1 = list(V = phen.var / 3, nu = nb_trait),
                           G2 = list(V = phen.var / 3, nu = nb_trait)), 
                  R = list(V = phen.var / 3, nu = nb_trait))

model_MCMC.NGM <- MCMCglmm(y ~ (logD + rel_humidity + temperature + session_id + population2) - 1, 
                           random = ~pop_label + date_str, 
                           #rcov = ~us(trait):units, 
                           family = rep("gaussian", nb_trait), 
                           prior = prior_mod, 
                           ginverse = list(pop_label = Ginv.mat), 
                           data = subset(d,env_label=='NGM'), 
                           nitt = 11000, 
                           burnin = 1000, 
                           thin = 100, 
                           pr = TRUE)

model_MCMC.NaCl <- MCMCglmm(y ~ (logD + rel_humidity + temperature + session_id + population2)  - 1, 
                           random = ~pop_label + date_str, 
                           #rcov = ~us(trait):units, 
                           family = rep("gaussian", nb_trait), 
                           prior = prior_mod, 
                           ginverse = list(pop_label = Ginv.mat), 
                           data = subset(d,env_label=='NaCl'), 
                           nitt = 11000, 
                           burnin = 1000, 
                           thin = 100, 
                           pr = TRUE)

save(list=c("gwas.NGM","gwas.NaCl","model_MCMC.NaCl","model_MCMC.NGM"),file=paste0('RData/Univariate_gridLMM_',ii,"_fixed.RData"))

}


