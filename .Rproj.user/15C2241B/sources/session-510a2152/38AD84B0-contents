### Multvariate
#### GBLUP ####
# Model as: y = Xb + Wr + u + e 
# X: fixed effects
# W: random effects
# u: follows normal distribution with variance of A*Var(u)

# Define prior model for GBLUP

# Convert Ginv to sparse matrix format
G_subset <- G[colnames(G)%in%unique(phen_with_iso$pop_label),colnames(G)%in%unique(phen_with_iso$pop_label)]
Ginv <- G.inverse(G = G_subset)$Ginv
Ginv.mat <- as(Ginv, "dgCMatrix")

nb_trait = length(vect_P_traits)

for(i in vect_P_traits){
  d[,i]= (d[,i]-mean(d[,i]))
}

phen.var = diag(nb_trait) * diag(var(subset(d, select = vect_P_traits)))
prior_mod <- list(G = list(G1 = list(V = phen.var / 3, nu = nb_trait),
                           G2 = list(V = phen.var / 3, nu = nb_trait)), 
                  R = list(V = phen.var / 3, nu = nb_trait))


model_MCMC.NGM <- MCMCglmm(cbind(SF, SB, FS, FB, BS, BF) ~ (logD + rel_humidity + temperature + session_id) + trait - 1, 
                           random = ~us(trait):pop_label + us(trait):date_str, 
                           rcov = ~us(trait):units, 
                           family = rep("gaussian", nb_trait), 
                           prior = prior_mod, 
                           ginverse = list(pop_label = Ginv.mat), 
                           data = subset(d,env_label=='NGM'), 
                           nitt = 110000, 
                           burnin = 10000, 
                           thin = 500, 
                           pr = TRUE)


save(list=c("model_MCMC.NGM"),file="RData/Multivariate_MCMCglmm_NGM_pruned_10k.RData")

