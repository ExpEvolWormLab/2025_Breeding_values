// ===================================================
// 1. USER PARAMETERS (defineConstant must be first)
// ===================================================
defineConstant("N", 1000);                 // population size
defineConstant("Xb", 10);                  // burn-in generations
defineConstant("Xg", 100);                 // total generations
defineConstant("SF", 0.5);                 // selfing rate after burn-in
defineConstant("CHR_L",20000000);         // chromosome length (bp)
defineConstant("VCF", "vcf/A6140_derived.I.vcf.gz");     // founder VCF
defineConstant("RECMAP", "map/CHRI.map.txt"); // recombination map file

// ===================================================
// 2. INITIALIZATION
// ===================================================
initialize() {
    initializeSLiMModelType("nonWF");      // non-overlapping generations
    initializeTreeSeq();

    initializeMutationRate(0.0);           // drift only
    initializeMutationType("m1", 0.5, "f", 0.0);
    initializeGenomicElementType("g1", m1, 1.0);

    initializeGenomicElement(g1, 0, CHR_L - 1);

    // Read recombination map from file: columns start end rate
    initializeRecombinationRateFromFile(RECMAP);
}

// ===================================================
// 3. HELPER FUNCTION TO WRITE ALLELE FREQUENCIES
// ===================================================
function (void) writeAF(string fname) {
    muts  = sortBy(sim.mutations, "position");
    freqs = sim.mutationFrequencies(p1, muts);

    lines = "position\tfrequency\n";
    for (i in seqAlong(muts)) {
        lines = lines + muts[i].position + "\t" + freqs[i] + "\n";
    }

    writeFile(fname, lines);
}

// ===================================================
// 4. CREATE POPULATION FROM VCF (generation 1)
// ===================================================
1 early() {
    sim.addSubpop("p1", N);
    p1.genomes.readFromVCF(VCF);
}

// ===================================================
// 5. REPRODUCTION: burn-in then selfing
// ===================================================
reproduction() {
    if (sim.generation <= Xb) {
        // burn-in: full random mating
        mate = subpop.sampleIndividuals(1);
        subpop.addCrossed(individual, mate);
    } else {
        // post-burn-in: selfing allowed
        if (runif(1) < SF) {
            subpop.addSelfed(individual);
        } else {
            mate = subpop.sampleIndividuals(1);
            subpop.addCrossed(individual, mate);
        }
    }
}

