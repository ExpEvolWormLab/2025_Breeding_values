// ===================================================
// 2. INITIALIZATION
// ===================================================
initialize()
{
	defineConstant("N1", 573); // burn-in generations
	defineConstant("N11", 10000); // expansion
	defineConstant("N2", 1000); // simulations
	defineConstant("Xb", 2); // burn-in generations
	defineConstant("Xg", 52); // total generations
	defineConstant("SF", 0.5); // selfing rate after burn-in
	defineConstant("CHR_L", 17000000); // chromosome length (bp)
	defineConstant("VCF", "/mnt/data3/mallard/2025_Breeding_values/SliM_simulations/vcf/A6140_derived.IV_nomissing.vcf"); // founder VCF
	defineConstant("RECMAP", "/mnt/data3/mallard/2025_Breeding_values/SliM_simulations/map/CHRIV.map.rates.txt"); // recombination map file
	defineConstant("RECMAP2", "/mnt/data3/mallard/2025_Breeding_values/SliM_simulations/map/CHRIV.map.ends.txt"); // recombination map file
	initializeSLiMModelType("WF");
	initializeMutationRate(0.0);
	initializeMutationType("m1", 0.5, "f", 0.0);
	m1.convertToSubstitution=F;
	initializeGenomicElementType("g1", m1, 1.0);
	lines_rates = readFile(RECMAP);
	lines_ends = readFile(RECMAP2);
	rates = c();
	ends = c();
	for (i in seqAlong(lines_rates))
	{
		line_rate = lines_rates[i];
		line_end = lines_ends[i];
		//catn("LINE: [" + line_rate + "]");
		//catn("LINE2: [" + line_end + "]");
		rate = asFloat(line_rate);
		end = asInteger(line_end);
		rates = c(rates, rate);
		ends = c(ends, end);
	}
	
	// add the last point
	rates = c(rates, 0.5);
	ends = c(ends, CHR_L);
	initializeGenomicElement(g1, 0, CHR_L - 1);
	initializeRecombinationRate(rates, ends);
}

// ===================================================
// 3. HELPER FUNCTION TO WRITE ALLELE FREQUENCIES
// ===================================================
function (void)writeAF(string fname)
{
	muts = sortBy(sim.mutations, "position");
	freqs = sim.mutationFrequencies(p1, muts);
	lines = "position\tfrequency\n";
	for (i in seqAlong(muts))
	{
		lines = lines + muts[i].position + "\t" + freqs[i] + "\n";
	}
	writeFile(fname, lines);
}

// ===================================================
// 4. CREATE POPULATION FROM VCF (generation 1)
// ===================================================
1 early()
{
	sim.addSubpop("p1", N1);
	p1.genomes.readFromVCF(VCF, mutationType=m1);
}
// ===================================================
// 4. CHANGE POPULATION SIZE
// ===================================================

2 early() { p1.setSubpopulationSize(N11); }
Xb early() { p1.setSubpopulationSize(N2); }


// ===================================================
// 7. STOPPING AND OPTIONAL OUTPUT
// ===================================================

Xb late() { 
	fname = paste("CHRIV_slimSimul", trialNumber, "G0.txt", sep = "");
	filename=paste0(fname);
	writeAF(fname); }

38 late() {
	fname = paste("CHRIV_slimSimul", trialNumber, "G36.txt", sep = "");
	writeAF(fname); }

Xg late()
{
	fname = paste("CHRIV_slimSimul", trialNumber, "G50.txt", sep = "");
	writeAF(fname);
	sim.simulationFinished();
}
